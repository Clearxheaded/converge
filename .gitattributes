# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure Go source files use LF
*.go text eol=lf

# Documentation and configs
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.tape text eol=lf
*.svg text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows PowerShell scripts
*.ps1 text eol=crlf
